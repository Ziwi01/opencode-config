{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-opus-5.5",
  "instructions": [
    "~/.config/opencode/shared/AGENTS.md"
  ],
  "skills": [
    "~/.config/opencode/shared/skills",
    "~/.config/opencode/shared/vendor"
  ],
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "serena": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "git+https://github.com/oraios/serena",
          "serena",
          "start-mcp-server",
          "--project-from-cwd"
        ]
      }
    }
  }
}
